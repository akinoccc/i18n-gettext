{
  "publisher": "akino",
  "name": "i18n-gettext",
  "displayName": "i18n Gettext",
  "type": "commonjs",
  "version": "1.0.0",
  "private": true,
  "description": "VSCode extension for extracting, compiling and managing gettext-based translation strings",
  "repository": {
    "type": "git",
    "url": "https://github.com/akinoccc/i18n-gettext.git"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension/index.js",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.89.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "i18n Gettext",
      "properties": {
        "i18n-gettext.localesConfig": {
          "type": "object",
          "default": {
            "type": "nested",
            "basePath": "src/language",
            "pattern": "${locale}/${domain}.po",
            "defaultDomain": "app",
            "sourceLanguage": "en-US"
          },
          "description": "Locales config"
        },
        "i18n-gettext.translator.engines": {
          "type": "array",
          "default": [
            "google"
          ]
        }
      }
    },
    "commands": [
      {
        "command": "i18n-gettext.selectEntry",
        "title": "Select Entry",
        "category": "i18n Gettext",
        "icon": "$(globe)"
      },
      {
        "command": "i18n-gettext.openTranslationEditor",
        "title": "Open Translation Editor",
        "category": "i18n Gettext",
        "icon": "$(edit)"
      },
      {
        "command": "i18n-gettext.searchEntries",
        "title": "Search Entries",
        "category": "i18n Gettext",
        "icon": "$(search)"
      },
      {
        "command": "i18n-gettext.clearSearch",
        "title": "Clear Search",
        "category": "i18n Gettext",
        "icon": "$(clear-all)"
      },
      {
        "command": "i18n-gettext.filterAllEntries",
        "title": "Show All Entries",
        "category": "i18n Gettext",
        "icon": "$(list-filter)"
      },
      {
        "command": "i18n-gettext.filterTranslatedEntries",
        "title": "Show Translated Entries",
        "category": "i18n Gettext",
        "icon": "$(check)"
      },
      {
        "command": "i18n-gettext.filterUntranslatedEntries",
        "title": "Show Untranslated Entries",
        "category": "i18n Gettext",
        "icon": "$(warning)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "i18n-gettext",
          "title": "i18n Gettext",
          "icon": "$(globe)"
        }
      ]
    },
    "views": {
      "i18n-gettext": [
        {
          "id": "i18n-gettext.fileTranslation",
          "name": "Current File Translations",
          "when": "true"
        },
        {
          "id": "i18n-gettext.progress",
          "name": "Translation Progress",
          "when": "true"
        },
        {
          "id": "i18n-gettext.entries",
          "name": "Translation Entries",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "i18n-gettext.searchEntries",
          "when": "view == i18n-gettext.entries",
          "group": "navigation"
        },
        {
          "command": "i18n-gettext.clearSearch",
          "when": "view == i18n-gettext.entries",
          "group": "navigation"
        },
        {
          "command": "i18n-gettext.filterAllEntries",
          "when": "view == i18n-gettext.entries",
          "group": "filter"
        },
        {
          "command": "i18n-gettext.filterTranslatedEntries",
          "when": "view == i18n-gettext.entries",
          "group": "filter"
        },
        {
          "command": "i18n-gettext.filterUntranslatedEntries",
          "when": "view == i18n-gettext.entries",
          "group": "filter"
        }
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "l10n:export": "npx @vscode/l10n-dev export --outDir ./l10n ./extension",
    "l10n:sync": "tsx scripts/sync-l10n.ts",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "ai": "^4.3.6",
    "gettext-parser": "^8.0.0"
  },
  "bundleDependencies": [
    "@vitalets/google-translate-api",
    "ai",
    "gettext-parser"
  ],
  "optionalDependencies": {
    "@ai-sdk/amazon-bedrock": "^2.2.8",
    "@ai-sdk/anthropic": "^1.2.10",
    "@ai-sdk/azure": "^1.3.17",
    "@ai-sdk/cerebras": "^0.2.11",
    "@ai-sdk/cohere": "^1.2.9",
    "@ai-sdk/deepinfra": "^0.2.12",
    "@ai-sdk/deepseek": "^0.2.11",
    "@ai-sdk/fal": "^0.1.9",
    "@ai-sdk/fireworks": "^0.2.11",
    "@ai-sdk/google": "^1.2.11",
    "@ai-sdk/google-vertex": "^2.2.15",
    "@ai-sdk/groq": "^1.2.8",
    "@ai-sdk/mistral": "^1.2.7",
    "@ai-sdk/openai": "^1.3.12",
    "@ai-sdk/perplexity": "^1.1.7",
    "@ai-sdk/replicate": "^0.2.7",
    "@ai-sdk/togetherai": "^0.2.11",
    "@ai-sdk/xai": "^1.2.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tomjs/tsconfig": "^1.7.1",
    "@tomjs/vite-plugin-vscode": "^4.0.0",
    "@tomjs/vscode-webview": "^2.0.2",
    "@types/gettext-parser": "^8.0.0",
    "@types/node": "18.x",
    "@types/vscode": "^1.89.0",
    "@unocss/reset": "66.1.0-beta.11",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.3.2",
    "eslint": "^9.24.0",
    "lucide-vue-next": "^0.488.0",
    "reactive-vscode": "^0.2.14",
    "tsup": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5",
    "unconfig": "^7.3.1",
    "unocss": "66.1.0-beta.11",
    "vite": "^6.2.6",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue": "^3.5.13"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
